<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 对应Mapper接口的全路径 -->
<mapper namespace="com.example.homework.mapper.ClazzMapper">

    <!-- 1. 分页查询所有班级 可根据teacher_id进行筛选 -->
    <select id="getClazzList" resultType="com.example.homework.vo.ClazzVo">
        SELECT
        c.*,
        IFNULL(u.name, '未知教师') AS teacherName
        FROM clazz c
        LEFT JOIN user u ON c.teacher_id = u.id
        <where>
            <if test="teacherId != null">AND c.teacher_id = #{teacherId}</if>
        </where>
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 2. 根据id查询班级 -->
    <select id="getClazzById" resultType="com.example.homework.entity.Clazz">
        SELECT id, clazz_name, teacher_id, create_time
        FROM clazz
        WHERE id = #{id}
    </select>

    <!-- 3. 添加新班级 -->
    <update id="updateClazz">
        UPDATE clazz
        <set>
            <if test="clazzName != null and clazzName != ''">
                clazz_name = #{clazzName},
            </if>
            <if test="teacherId != null">
                teacher_id = #{teacherId},
            </if>
            update_time = NOW()
        </set>

        WHERE id = #{id}
    </update>

    <!-- 4. 修改班级信息 -->
    <insert id="addClazz" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO clazz (clazz_name, teacher_id, create_time)
        VALUES (#{clazzName}, #{teacherId}, NOW())
    </insert>

    <!-- 5. 根据id删除班级 -->
    <delete id="deleteClazz">
        DELETE FROM clazz
        WHERE id = #{id}
    </delete>
    <select id="getClazzCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM clazz
        <where>
            <if test="teacherId != null">
                AND teacher_id = #{teacherId}
            </if>
        </where>
    </select>

</mapper>