<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 对应Mapper接口的全路径 -->
<mapper namespace="com.example.homework.mapper.UserMapper">

    <!-- 根据username查询用户 -->
    <select id="getUserByUsername" resultType="boolean">
        SELECT count(name) > 0
        FROM user
        where username = #{username}
    </select>
    <!-- 登录查询 -->
    <select id="login" resultType="com.example.homework.entity.User">
        SELECT id,
               img,
               name,
               role_id,
               clazz_id
        FROM user
        WHERE username = #{username}
          and password = #{password}
    </select>

    <!-- 注册用户（动态SQL） -->
    <insert id="register" parameterType="com.example.homework.entity.User">
        INSERT INTO user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            username,
            password,
            <if test="name != null and name != ''">
                name,
            </if>
            <if test="roleId != null">
                role_id,
            </if>
            <if test="clazzId != null">
                clazz_id,
            </if>
            create_time,
            update_time
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            #{username},
            #{password},
            <if test="name != null and name != ''">
                #{name},
            </if>
            <if test="roleId != null">
                #{roleId},
            </if>
            <if test="clazzId != null">
                #{clazzId},
            </if>
            NOW(),
            NOW()
        </trim>
    </insert>
    <!-- 分页查询用户   -->
    <select id="getUserList" resultType="com.example.homework.entity.User">
        SELECT
        u.id, u.username, u.password, u.name, u.role_id, u.clazz_id,
        u.create_time, u.update_time, u.img
        FROM user u
        LEFT JOIN role r ON u.role_id = r.id
        <where>
            <if test="role != null and role != ''">
                AND r.role_name = #{role}
            </if>
            <if test="clazzId != null and clazzId != ''">
                AND u.clazz_id = #{clazzId}
            </if>
        </where>
        ORDER BY u.create_time DESC
        LIMIT #{pageSize} OFFSET #{offset}  <!-- 直接用计算好的偏移量 -->
    </select>


    <!-- 批量添加用户   -->
    <insert id="addUser">
        INSERT INTO user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            username,
            password,
            name,
            role_id,
            <foreach collection="users" item="user" index="index" open="" close="" separator="">
                <if test="index == 0">
                    <if test="user.clazzId != null">clazz_id,</if>
                    create_time,
                    update_time,
                    <if test="user.img != null and user.img != ''">img,</if>
                </if>
            </foreach>
        </trim>
        VALUES
        <foreach collection="users" item="user" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{user.username},
                #{user.password},
                #{user.name},
                #{user.roleId},
                <if test="user.clazzId != null">#{user.clazzId},</if>
                NOW(),
                NOW(),
                <if test="user.img != null and user.img != ''">#{user.img},</if>
            </trim>
        </foreach>
    </insert>


    <!-- 更改用户信息   -->
    <update id="updateUser">
        UPDATE user
        <set>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="roleId != null">
                role_id = #{roleId},
            </if>
            <if test="clazzId != null">
                clazz_id = #{clazzId},
            </if>
            <if test="img != null and img != ''">
                img = #{img},
            </if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>


    <!-- 删除用户   -->
    <delete id="deleteUser">
        DELETE
        FROM user
        WHERE id = #{id}
    </delete>

    <select id="checkIsTeacherById" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0
        FROM user
        WHERE id = #{id}
          AND role_id = 2
    </select>
    <!-- 查询总数 -->
    <select id="getUserCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM user
        <where>
            <if test="role != null and role != ''">AND role_id = #{role}</if>
            <if test="clazz != null and clazz != ''">AND clazz_id = #{clazz}</if>
        </where>
    </select>
    <!-- 根据用户ID获取姓名 -->
    <select id="getNameById" resultType="java.lang.String">
        SELECT name
        FROM user
        WHERE id = #{id}
    </select>
    <select id="getClazzIdByUserId" resultType="java.lang.Long">
        SELECT clazz_id FROM user WHERE id = #{userId}
    </select>
</mapper>
